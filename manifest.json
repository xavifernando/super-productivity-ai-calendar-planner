{
  "id": "ai-calendar-planner",
  "name": "AI Calendar & Habits Planner",
  "version": "4.6.1",
  "manifestVersion": 1,
  "minSupVersion": "18.0.0",
  "author": "xavier sethu",
  "description": "AI-assisted daily task and calendar planner with Today/Tomorrow scheduling, habits, and Super Productivity task integration.",
  "iFrame": true,
  "icon": "icon.svg",
  "permissions": [
    "http",
    "getTasks",
    "addTask",
    "updateTask",
    "getAllProjects",
    "getCounter",
    "setCounter",
    "showSnack"
  ],
  "hooks": [
    "finishDay"
  ],
  "allowedHosts": [
    "generativelanguage.googleapis.com",
    "api.openai.com",
    "api.anthropic.com",
    "openrouter.ai",
    "api.groq.com"
  ]
}