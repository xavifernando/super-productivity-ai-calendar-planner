{
  "id": "ai-calendar-planner",
  "name": "AI Calendar & Habits Planner",
  "version": "4.5.2",
  "manifestVersion": 1,
  "minSupVersion": "18.0.0",
  "author": "xavier sethu",
  "description": "Universal AI daily task & calendar scheduler with continuous hour-by-hour timeblocking, Tomorrow planning, Habits & Rituals System, SuperSync mobile compatibility, and Super Productivity Habits integration.",
  "iFrame": true,
  "icon": "icon.svg",
  "permissions": [
    "http",
    "getTasks",
    "getArchivedTasks",
    "getCurrentContextTasks",
    "addTask",
    "updateTask",
    "deleteTask",
    "getAppState",
    "getAllProjects",
    "getAllTags",
    "getAllSimpleCounters",
    "getSimpleCounter",
    "updateSimpleCounter",
    "setCounter",
    "incrementCounter",
    "showSnack",
    "openDialog"
  ],
  "hooks": [
    "taskCreated",
    "taskComplete",
    "taskUpdate",
    "currentTaskChange",
    "finishDay"
  ],
  "allowedHosts": [
    "generativelanguage.googleapis.com",
    "api.openai.com",
    "api.anthropic.com",
    "openrouter.ai",
    "api.groq.com",
    "localhost",
    "calendar.google.com"
  ]
}